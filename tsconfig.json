{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".build",
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": [
    "apps/**/*.ts",
    "workers/**/*.ts",
    "packages/**/*.ts",
    "apps/web/src/**/*.js"
  ]
}