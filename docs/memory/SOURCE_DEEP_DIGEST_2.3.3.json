  "globalFindings": [
    "Historical Excel files are executable business specifications, not merely UI templates.",
    "Expected, collected and disbursed values are distinct and may legitimately diverge.",
    "Interest visibility can be governed and delayed; provisional is not final.",
    "Loan rate and interest method may vary by policy/time and require versioning.",
    "Savings yield allocation can depend on temporal presence/weights and a shared interest pool.",
    "Old/new member status and registration amounts are historical policy inputs, not universal constants.",
    "Legacy UI limits, broken references and workbook protections are migration artifacts, not canonical business rules.",
    "Discovery/search intent predates 2026 and is now consolidated as mutual member↔group discovery with consent/policy."
  ],
  "unresolvedOrNeedsFieldValidation": [
    "Exact semantics of some locally named cashboxes/rubrics must always be confirmed from the target group RI/rules before activation.",
    "Historical formulas with mixed aggregates need scenario-by-scenario migration tests before financial pilot.",
    "Any actual legacy data migration requires reconciliation totals and human validation."
  ]
}
