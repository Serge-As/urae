{
  "name": "tontine-platform",
  "version": "1.5.2-42",
  "private": true,
  "type": "module",
  "description": "Eco-System: consolidated productive journeys, canonical resource calendars, consented public notebooks, collective launch programmes, private reminders and local reviewed document preparation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "lint:architecture": "node scripts/architecture-fitness.mjs",
    "lint:constitution": "node scripts/constitution-lint.mjs",
    "ci": "npm run audit:dependencies && npm run typecheck && npm run lint:architecture && npm run lint:shared-governance && npm run lint:constitution && npm run lint:truth && npm run lint:memory && npm run lint:memory-index && npm run lint:source-coverage && npm run lint:proposals && npm run test",
    "demo": "node scripts/dev-server.mjs",
    "demo:rebuild": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "memory:recall": "node scripts/memory-recall.mjs",
    "lint:memory": "node scripts/memory-gate.mjs",
    "memory:index": "node scripts/build-memory-index.mjs",
    "lint:memory-index": "node scripts/build-memory-index.mjs --check",
    "lint:source-coverage": "node scripts/source-coverage-lint.mjs",
    "lint:truth": "node scripts/project-truth-gate.mjs",
    "lint:shared-governance": "node scripts/shared-governance-lint.mjs && node scripts/service-solidarity-lint.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "lint:proposals": "node scripts/proposal-coverage-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "^5.8.3",
    "ws": "8.21.0"
  }
}
